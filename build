#!/bin/bash
clean=1
if [[ $1 = "-clean" ]] ; then
    clean=0
    shift
fi
if [[ $# -eq 0 ]] ; then
    for i in *.org; do sources+=("$i"); done # "" required to handle filename with space(s)
else
    sources=("$@") # idem
fi
for i in "${sources[@]}" ; do # "" required to handle filename with space(s)
    if ! egrep -q -- '-\*- mode: org; -\*-' "$i" ; then continue; fi
    s=$i
    t=${i%.org}.tex
    p=${i%.org}.pdf
    h=${i%.org}.html
    d=${i%.org}.deps
    a=${i%.org}.auxdir
    if [[ $clean -eq 0 ]] ; then
        rm -rf "$t" "$p" "$h" "$d" "$a"
    else
        # basic tests for rebuild cases ; to be improved
        # missing target tex and pdf
        # source newer than target tex
        # this script newer than target tex
        if [[ (! -e $t) || (! -e $p) || $s -nt $t || $0 -nt $t ]] ; then
            emacs --batch \
	          -l .emacs.d/org-mode_batch_init.el \
	          --visit "$s" \
	          -f org-latex-export-to-latex
            latexmk -f -pdf -xelatex -interaction=nonstopmode \
                    -deps-out="$d" \
                    -auxdir="$a" "$t"
        fi
        # missing target html
        # source newer that target html
        # this script newer than target html
        if [[ (! -e $h) || $s -nt $h || $0 -nt $h ]] ; then
            emacs --batch \
	          -l .emacs.d/org-mode_batch_init.el \
	          --visit "$s" \
	          -f org-html-export-to-html
        fi
    fi
done
