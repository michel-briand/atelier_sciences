#!/bin/bash

me=${0##*/}
md=${0%/*}

: ${ATELIER_ROOT:=$(realpath $md)}
: ${EMACS_ROOT:=$HOME/.emacs.d}

if [ "$GITHUB_ACTIONS" == "true" ] ; then
    echo "Running in pipeline"
else
    if [ -d "$ATELIER_ROOT/.emacs.d" ] ; then
        EMACS_ROOT=$ATELIER_ROOT/.emacs.d
    else
        echo "Error" >&2
        exit 1
    fi
fi

# Emacs installation
function emacs_installation {
    echo "Installing / updating Emacs installation..."
    emacs --batch -Q \
          --init-directory $EMACS_ROOT \
          -l $EMACS_ROOT/emacs_install.el
    touch $EMACS_ROOT/atelier_sciences.installed
}

if [[ ! -d $EMACS_ROOT/elpa ]] || \
       [[ ! -e $EMACS_ROOT/atelier_sciences.installed ]] ; then
    emacs_installation
fi

# Arguments

clean=1
publish=0

while getopts "cp" option
do
  case $option in
      # -c clean
      c ) clean=0 ;;
      # -p publish
      p ) publish=1 ;;
      ? ) echo "Argument invalide." >&2; exit 1 ;;
  esac
done
shift $(($OPTIND - 1))


if [[ -e .builddoc.env ]] ; then
    set -e
    echo "Chargement du fichier de configuration du projet .builddoc.env"
    source .builddoc.env
    set +e
fi

emacs_user_full_name=$(emacs --batch -Q --eval '(princ user-full-name)')

echo "emacs_user_full_name=$emacs_user_full_name"

# If AUTHOR is set it takes precedence
: ${AUTHOR:=$GITHUB_ACTOR} # else GITHUB_ACTOR
: ${AUTHOR:=$emacs_user_full_name} # else user full name (local)

echo "AUTHOR=$AUTHOR"

function emacs_cmd {
    echo "Producing document for $@ in $PWD"
    emacs --batch -Q \
          --init-directory $EMACS_ROOT \
	  -l $ATELIER_ROOT/lib/org-mode_new-init.el \
          --eval "(setq user-full-name \"$AUTHOR\")" \
          "$@"
}

products=()

# Loop through sources
: ${DOCUMENTS_ROOT:=$PWD}

cd $DOCUMENTS_ROOT

# peut-être charger le fichier env ici ?

if [[ $# -eq 0 ]] ; then
    for i in *.org; do sources+=("$i"); done
else
    sources=("$@")
fi

for i in "${sources[@]}" ; do
    s=$i
    t=${i%.org}.tex
    p=${i%.org}.pdf
    h=${i%.org}.html
    d=${i%.org}.deps
    a=${i%.org}.auxdir
    if [[ $clean -eq 0 ]] ; then
        rm -rf "$t" "$p" "$h" "$d" "$a"
    else
        # missing target pdf
        # source newer than target
        # this script newer than target
        if [[ (! -e $p) || $s -nt $p || $0 -nt $p ]] ; then
            echo ">>>           $s => $p"
            emacs_cmd \
	          --visit "$s" \
                  -f org-babel-execute-buffer \
	          -f org-latex-export-to-pdf
            if [ $? -eq 0 ] ; then
                products+=("$PWD/$p")
            fi
        fi
        # missing target html
        # source newer that target
        # this script newer than target
        if [[ (! -e $h) || $s -nt $h || $0 -nt $h ]] ; then
            echo ">>>           $s => $h"
            emacs_cmd \
	          --visit "$s" \
	          -f org-html-export-to-html
            if [ $? -eq 0 ] ; then
                products+=("$PWD/$h" "$PWD/org.css")
            fi
        fi
    fi
done

if [[ "$GITHUB_ACTIONS" == "true" ]] || [[ $publish == 1 ]] ; then
    if [[ "$GITHUB_ACTIONS" == "true" ]] ; then
        TARGET=/webdir
    else
        if [[ -z $BUILDDOC_WEBDIR ]] ; then
            echo "Variable BUILDDOC_WEBDIR non définie. Erreur." >&2
            exit 1
        fi
        TARGET=$BUILDDOC_WEBDIR
    fi
    if [[ ! -d $TARGET ]] ; then
        echo "Le répertoire $TARGET n'existe pas. Erreur." >&2
        exit 1
    fi
    echo "Copie les fichiers produits vers le site web : $TARGET"
    echo "Chemin relatif défini dans le projet : $BUILDDOC_WEBDIR_FOLDER"
    for i in "${products[@]}" ; do
        echo "$i"
        cp -vf "$i" "$TARGET/$BUILDDOC_WEBDIR_FOLDER"
    done
fi
