#!/bin/bash -x

me=${0##*/}
md=${0%/*}

: ${ATELIER_ROOT:=$(realpath $md)}
: ${EMACS_ROOT:=$HOME/.emacs.d}

if [ "$GITHUB_ACTIONS" == "true" ] ; then
    echo "Running in pipeline"
else
    if [ -d "$ATELIER_ROOT/.emacs.d" ] ; then
        EMACS_ROOT=$ATELIER_ROOT/.emacs.d
    else
        echo "Error" >&2
        exit 1
    fi
fi

# Emacs installation
function emacs_installation {
    echo "Installing / updating Emacs installation..."
    emacs --batch -Q \
          --init-directory $EMACS_ROOT \
          -l $EMACS_ROOT/emacs_install.el
    touch $EMACS_ROOT/atelier_sciences.installed
}

if [[ ! -d $EMACS_ROOT/elpa ]] || \
       [[ ! -e $EMACS_ROOT/atelier_sciences.installed ]] ; then
    emacs_installation
fi

# Arguments

clean=1
if [[ $1 = "-clean" ]] ; then
    clean=0
    shift
fi

emacs_user_full_name=$(emacs --batch -Q --eval '(princ user-full-name)')

echo "emacs_user_full_name=$emacs_user_full_name"

# If AUTHOR is set it takes precedence
: ${AUTHOR:=$GITHUB_ACTOR} # else GITHUB_ACTOR
: ${AUTHOR:=$emacs_user_full_name} # else user full name (local)

echo "AUTHOR=$AUTHOR"

function emacs_cmd {
    echo "Producing document for $@ in $PWD"
    emacs --batch -Q \
          --init-directory $EMACS_ROOT \
	  -l $ATELIER_ROOT/lib/org-mode_new-init.el \
          --eval "(setq user-full-name \"$AUTHOR\")" \
          "$@"
}

products=()

# Loop through sources
: ${DOCUMENTS_ROOT:=$PWD}

cd $DOCUMENTS_ROOT

if [[ $# -eq 0 ]] ; then
    for i in *.org; do sources+=("$i"); done
else
    sources=("$@")
fi

for i in "${sources[@]}" ; do
    s=$i
    t=${i%.org}.tex
    p=${i%.org}.pdf
    h=${i%.org}.html
    d=${i%.org}.deps
    a=${i%.org}.auxdir
    if [[ $clean -eq 0 ]] ; then
        rm -rf "$t" "$p" "$h" "$d" "$a"
    else
        # missing target pdf
        # source newer than target
        # this script newer than target
        if [[ (! -e $p) || $s -nt $p || $0 -nt $p ]] ; then
            echo ">>>           $s => $p"
            set -x
            emacs_cmd \
	          --visit "$s" \
                  -f org-babel-execute-buffer \
	          -f org-latex-export-to-pdf
            if [ $? -eq 0 ] ; then
                products+=("$PWD/$p")
            fi
            set +x
        fi
        # missing target html
        # source newer that target
        # this script newer than target
        if [[ (! -e $h) || $s -nt $h || $0 -nt $h ]] ; then
            echo ">>>           $s => $h"
            set -x
            emacs_cmd \
	          --visit "$s" \
	          -f org-html-export-to-html
            if [ $? -eq 0 ] ; then
                products+=("$PWD/$h" "$PWD/org.css")
            fi
            set +x
        fi
    fi
done

if [ "$GITHUB_ACTIONS" == "true" ] ; then
    (
        printf "products<<EOF\n"
        for i in "${products[@]}" ; do
            printf "$i\n"
            # /var/www/html/argconsulting/pub:/webdir
            if [[ -d /webdir ]] ; then
                cp -vf "$i" "/webdir"
            fi
        done
        printf "EOF\n"
    ) >> "${GITHUB_ENV:=/dev/stdout}"
fi
